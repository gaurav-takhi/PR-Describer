{
  "manifest_version": 3,
  "name": "PR Describer",
  "version": "0.1.0",
  "description": "Auto-fill pull request title and description from your commits. Rule-based by default; optional bring-your-own LLM key.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://dev.azure.com/*",
    "https://github.com/*",
    "https://api.github.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dev.azure.com/*",
        "https://github.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html",
  "action": {
    "default_title": "PR Describer settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}